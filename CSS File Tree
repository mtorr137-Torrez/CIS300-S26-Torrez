body {
    font-family: Arial, sans-serif;
    margin: 0;
}

header {
    background: #2e7d32;
    color: white;
    padding: 15px;
    text-align: center;
}

nav {
    background: #444;
    padding: 10px;
    text-align: center;
}

nav a {
    color: white;
    margin: 10px;
    text-decoration: none;
}

main {
    padding: 20px;
}

footer {
    background: #2e7d32;
    color: white;
    text-align: center;
    padding: 10px;
}

table {
    width: 100%;
    border-collapse: collapse;
}

table, th, td {
    border: 1px solid black;
    padding: 10px;
}

form input, form textarea {
    display: block;
    margin: 10px 0;
    padding: 8px;
}
